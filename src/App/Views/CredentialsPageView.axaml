<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:TkmmKaren.Dashboard.Views"
             xmlns:vm="using:TkmmKaren.Dashboard.ViewModels"
             x:Class="TkmmKaren.Dashboard.Views.CredentialsPageView"
             x:DataType="vm:CredentialsPageViewModel"
             Background="#1F1F1F">
    <StackPanel Width="320"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
        <TextBlock FontSize="22"
                   Text="Log access" />
        <TextBlock Opacity="0.8"
                   Text="This log is protected. Sign in to continue."
                   TextWrapping="Wrap" />
        <views:SignInForm x:Name="Form" Height="174" />
    </StackPanel>
</UserControl>
